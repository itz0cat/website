{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": "public",
  "functions": {
    "api/download.js": { "maxDuration": 60, "includeFiles": "private/jars/**" },
    "api/*.js": { "maxDuration": 60 },
    "api/auth/*.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/download", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "redirects": [
    { "source": "/downloads", "destination": "/download", "permanent": true },
    { "source": "/terms", "destination": "/legal#terms", "permanent": true },
    { "source": "/refunds", "destination": "/legal#refunds", "permanent": true },
    { "source": "/maintenance", "destination": "/", "permanent": false }
  ]
}
