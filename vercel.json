{
  "version": 2,
  "cleanUrls": true,
  "functions": { "api/*.js": { "maxDuration": 60 }, "api/auth/*.js": { "maxDuration": 30 } },
  "trailingSlash": false,
  "redirects": [
    { "source": "/download", "destination": "/redeem", "permanent": true },
    { "source": "/downloads", "destination": "/redeem", "permanent": true },
    { "source": "/terms", "destination": "/legal#terms", "permanent": true },
    { "source": "/refunds", "destination": "/legal#refunds", "permanent": true },
    { "source": "/maintenance", "destination": "/", "permanent": false }
  ]
}
